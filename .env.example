# ---------------------------------------------------------------------------
# JHJ DSS — copy to .env and change every value before deploying.
#   cp .env.example .env
#   openssl rand -hex 32      # use this for JWT_SECRET / INGEST_API_KEY
# The Node auth gateway and the FastAPI service share JWT_* values.
# ---------------------------------------------------------------------------

# --- Shared JWT settings (MUST match in both services) ---
JWT_SECRET=CHANGE_ME
JWT_ISSUER=jhj-auth
JWT_AUDIENCE=jhj-dss
ACCESS_TOKEN_TTL=8h
CHALLENGE_TOKEN_TTL=5m
AUTH_COOKIE_NAME=jhj_token

# --- CORS allow-list (comma separated, no wildcards) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Team onboarding ---
TEAM_INVITE_CODE=replace-with-a-private-invite-code
CREATOR_MASTER_PIN=replace-with-a-private-pin
BCRYPT_ROUNDS=12

# --- Seed the first Creator account (only used when the user store is empty) ---
SEED_ADMIN_USER_ID=admin@jhj
SEED_ADMIN_PASSWORD=CHANGE_ME_123
SEED_ADMIN_NAME=Warehouse Administrator
SEED_ADMIN_QUESTION=What is your operations call sign?
SEED_ADMIN_ANSWER=jhj-command

# --- FastAPI checkout ingress (server-to-server API key) ---
INGEST_API_KEY=CHANGE_ME

# --- FastAPI -> auth gateway session introspection (revocation check) ---
# Use http://server:5000 when running under docker compose.
AUTH_GATEWAY_URL=http://localhost:5000
AUTH_INTROSPECTION_ENABLED=true
AUTH_INTROSPECTION_TTL_SECONDS=60

# --- Ports ---
PORT=5000

# --- Optional rate-limit tuning ---
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=20
GLOBAL_RATE_WINDOW_MS=900000
GLOBAL_RATE_MAX=300
